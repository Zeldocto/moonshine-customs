# ---------------------------------------------------------------------------
# PUBLIC values only. Everything with a VITE_ prefix is compiled into the
# JavaScript bundle and is readable by anyone who visits the site.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=https://jwkxwgccgjvcfpcousns.supabase.co/rest/v1/

# Supabase "anon" / "publishable" key. This key is DESIGNED to be public.
# It grants no privileges by itself: every table is protected by Row Level
# Security, so the key can only do what the policies allow.
VITE_SUPABASE_ANON_KEY=sb_publishable_JhcBz3eqOqEPLesvHRjH8g_nvCmz638

# ---------------------------------------------------------------------------
# NEVER put these in this file, in the repo, or in any VITE_ variable:
#   - SUPABASE_SERVICE_ROLE_KEY  (bypasses ALL Row Level Security)
#   - the database password / direct Postgres connection string
#   - JWT secret
# Those belong in the Supabase dashboard and, if you ever add server-side
# jobs, in GitHub Actions *secrets* used only by non-frontend steps.
# ---------------------------------------------------------------------------
